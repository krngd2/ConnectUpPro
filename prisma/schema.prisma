generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "foreignKeys"
  extensions   = [uuid_ossp(map: "uuid-ossp", schema: "extensions"), vector]
}

model Channel {
  id           String  @id @default(uuid())
  name         String
  userId       String
  profilePhoto String?
  user         User    @relation(fields: [userId], references: [id])
  videos       Video[]
}

model Cluster {
  id              String    @id @default(uuid())
  name            String
  description     String?
  videoId         String
  parentClusterId String?
  level           Int       @default(0)
  commentCount    Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  video           Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  parentCluster   Cluster?  @relation("ClusterHierarchy", fields: [parentClusterId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  subClusters     Cluster[] @relation("ClusterHierarchy")
  comments        Comment[]

  @@index([videoId])
  @@index([parentClusterId])
}

model Comment {
  id           String                 @id @default(uuid())
  platformId   String                 @unique
  text         String
  authorName   String
  authorAvatar String?
  timestamp    DateTime
  likeCount    Int                    @default(0)
  replyCount   Int                    @default(0)
  videoId      String
  analysis     Json
  embedding    Unsupported("vector")?
  isReply      Boolean                @default(false)
  clusterId    String?
  video        Video                  @relation(fields: [videoId], references: [id], onDelete: Cascade)
  cluster      Cluster?               @relation(fields: [clusterId], references: [id], onDelete: SetNull)

  @@index([embedding], map: "comment_embedding_cosine_hnsw_idx")
  @@index([videoId])
  @@index([clusterId])
}

model Project {
  id              String   @id @default(uuid())
  name            String
  status          String   @default("PENDING")
  userId          String
  analysisSummary Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model SemanticSearch {
  id        String   @id @default(uuid())
  title     String
  userId    String
  examples  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String   @default("Default")
  isDefault Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])

  // Ensure a user can't have duplicate default searches with the same category/title
  @@unique([userId, category, title, isDefault], name: "user_category_title_isDefault_unique")
}

model User {
  id                     String           @id @default(uuid())
  email                  String           @unique
  name                   String?
  avatarUrl              String?
  preferences            Json             @default("{\"emailUpdates\": false, \"notifyAnalysisComplete\": false, \"weeklySummary\": false}")
  createdAt              DateTime         @default(now())
  metadata               Json             @default("{\"hasCompletedDashboardTour\": false, \"hasCompletedAnalysisTour\": false}")
  channels               Channel[]
  videos                 Video[]
  projects               Project[]
  semanticSearches       SemanticSearch[]
}

model Video {
  id                String    @id @default(uuid())
  url               String    @unique
  title             String?
  thumbnailUrl      String?
  name              String
  status            String    @default("PENDING")
  userId            String
  channelId         String?
  analysisSummary   Json?
  lastSynced        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  sentimentAnalysis Json?
  comments          Comment[]
  clusters          Cluster[]
  channel           Channel?  @relation(fields: [channelId], references: [id])
  user              User      @relation(fields: [userId], references: [id])
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model wrappers_fdw_stats {
  fdw_name     String   @id
  create_times BigInt?
  rows_in      BigInt?
  rows_out     BigInt?
  bytes_in     BigInt?
  bytes_out    BigInt?
  metadata     Json?
  created_at   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
  updated_at   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamptz(6)
}
