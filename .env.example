# PostgreSQL with the pgvector extension enabled
DATABASE_URL="postgresql://connectuppro:connectuppro@localhost:5432/connectuppro?schema=public"

# One Google API key is used for YouTube Data API v3 and Gemini
GOOGLE_API_KEY="your_google_api_key"

# Optional: customize the local workspace identity shown in Settings
# LOCAL_USER_NAME="Local Workspace"
# LOCAL_USER_EMAIL="local@connectuppro.local"

# Optional: used only for constructing links in future integrations
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
